{
  "expo": {
    "name": "MoyennesED",
    "slug": "moyennesed",
    "version": "4.0.22",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "e17b020c-b1bf-4f61-9fa6-7bf681626451"
      }
    },
    "owner": "finocchiarodev",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-font",
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Notifications"
          ]
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "me.diegof.moyennesed",
      "versionCode": 57,
      "userInterfaceStyle": "automatic"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.diegof.moyennesed",
      "buildNumber": "4",
      "userInterfaceStyle": "automatic"
    }
  }
}
